{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "ServiceBus": {
    "QueueName": "employee-events"
  },
  "Storage": {
    "ContainerName": "profile-pictures",
    "MaxProfilePictureBytes": 5242880
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  }
}
