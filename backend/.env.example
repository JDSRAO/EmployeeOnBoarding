# Copy to backend/.env and fill in real values. Never commit .env.

# SQL Server SA password used by docker-compose (must meet SQL complexity rules)
MSSQL_SA_PASSWORD=Your_strong_Password123

# Host port mapped to the API container
API_PORT=8080

# Required by the API at startup (from Azure portal / Key Vault / set-local-secrets.ps1)
BLOB_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://....servicebus.windows.net/;SharedAccessKeyName=...;SharedAccessKey=...

# Optional overrides
SERVICE_BUS_QUEUE_NAME=employee-events
STORAGE_CONTAINER_NAME=profile-pictures
CORS_ORIGIN=http://localhost:3000
